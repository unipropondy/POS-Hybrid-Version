{
  "expo": {
    "name": "Smart POS",
    "slug": "pos-1",
    "version": "3.0.1",
    "orientation": "default",
    "icon": "./assets/images/logo_pos.png",
    "scheme": "restaurantapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#F8FAFC",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "This app needs Bluetooth access to connect to thermal printers for receipts.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.unipro.pos"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF8C00",
        "foregroundImage": "./assets/images/logo_pos.png"
      },
      "package": "com.unipro.pos",
      "versionCode": 5,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo_pos.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo_pos.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FF8C00",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "01565dfd-20a9-4846-b3e3-84bd2fa9fca8"
      }
    },
    "owner": "azmiunipros-organization"
  }
}
